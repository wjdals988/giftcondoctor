rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function memberPath(roomId, uid) {
      return /databases/$(database)/documents/rooms/$(roomId)/members/$(uid);
    }

    function roomPath(roomId) {
      return /databases/$(database)/documents/rooms/$(roomId);
    }

    function couponPath(roomId, couponId) {
      return /databases/$(database)/documents/rooms/$(roomId)/coupons/$(couponId);
    }

    function isRoomMember(roomId) {
      return signedIn() && exists(memberPath(roomId, request.auth.uid));
    }

    function isRoomOwner(roomId) {
      return signedIn()
        && exists(roomPath(roomId))
        && get(roomPath(roomId)).data.ownerUid == request.auth.uid;
    }

    function visibleCoupon(data) {
      return data.visibility == "room"
        || (data.visibility == "private" && data.ownerUid == request.auth.uid);
    }

    function visibleParentCoupon(roomId, couponId) {
      return exists(couponPath(roomId, couponId))
        && visibleCoupon(get(couponPath(roomId, couponId)).data);
    }

    function validCouponImagePath(roomId, couponId) {
      return request.resource.data.imageBlobPath is string
        && request.resource.data.imageBlobPath.matches(
          '^rooms/' + roomId + '/coupons/' + couponId + '/[A-Za-z0-9._-]+$'
        )
        && (!request.resource.data.keys().hasAny(["thumbnailBlobPath"])
          || (request.resource.data.thumbnailBlobPath is string
            && request.resource.data.thumbnailBlobPath.matches(
              '^rooms/' + roomId + '/coupons/' + couponId + '/[A-Za-z0-9._-]+$'
            )));
    }

    function validCouponBarcode(data) {
      return !data.keys().hasAny(["barcodeValue", "barcodeFormat"])
        || (data.keys().hasAll(["barcodeValue", "barcodeFormat"])
          && data.barcodeValue is string
          && data.barcodeValue.size() > 0
          && ((data.barcodeFormat in ["CODE_128", "CODE_39", "CODE_93", "CODABAR", "ITF"]
              && data.barcodeValue.size() <= 80)
            || (data.barcodeFormat == "EAN_13" && data.barcodeValue.matches('^[0-9]{12,13}$'))
            || (data.barcodeFormat == "EAN_8" && data.barcodeValue.matches('^[0-9]{7,8}$'))
            || (data.barcodeFormat == "UPC_A" && data.barcodeValue.matches('^[0-9]{11,12}$'))
            || (data.barcodeFormat == "UPC_E" && data.barcodeValue.matches('^[0-9]{7,8}$'))
            || (data.barcodeFormat in ["QR_CODE", "PDF_417", "AZTEC", "DATA_MATRIX"]
              && data.barcodeValue.size() <= 1024)));
    }

    function validCouponSchema(roomId, couponId) {
      return request.resource.data.keys().hasOnly([
          "title", "brand", "ownerUid", "imageBlobPath", "thumbnailBlobPath", "imageWidth", "imageHeight",
          "expiresLocalDate", "expiresAtUtc", "timezone", "status", "reservedByUid",
          "usedByUid", "usedAt", "visibility", "notifyTarget", "barcodeValue", "barcodeFormat",
          "createdAt", "updatedAt"
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.brand is string
        && request.resource.data.brand.size() <= 100
        && request.resource.data.expiresLocalDate is string
        && request.resource.data.expiresLocalDate.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.status in ["active", "reserved", "used", "expired"]
        && request.resource.data.visibility in ["room", "private"]
        && request.resource.data.notifyTarget in ["allMembers", "ownerOnly"]
        && validCouponBarcode(request.resource.data)
        && validCouponImagePath(roomId, couponId);
    }

    function immutableCouponFields() {
      return request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.imageBlobPath == resource.data.imageBlobPath
        && request.resource.data.get("thumbnailBlobPath", null) == resource.data.get("thumbnailBlobPath", null)
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function ownerCanEditCoupon(roomId, couponId) {
      return resource.data.ownerUid == request.auth.uid
        && immutableCouponFields()
        && validCouponSchema(roomId, couponId)
        && visibleCoupon(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "title", "brand", "expiresLocalDate", "expiresAtUtc", "timezone",
          "visibility", "notifyTarget", "updatedAt"
        ]);
    }

    function memberCanReserve() {
      return resource.data.status == "active"
        && request.resource.data.status == "reserved"
        && request.resource.data.reservedByUid == request.auth.uid
        && request.resource.data.usedByUid == resource.data.usedByUid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "reservedByUid", "updatedAt"]);
    }

    function memberCanCancelReservation() {
      return resource.data.status == "reserved"
        && request.resource.data.status == "active"
        && request.resource.data.reservedByUid == null
        && (resource.data.reservedByUid == request.auth.uid || resource.data.ownerUid == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "reservedByUid", "updatedAt"]);
    }

    function memberCanMarkUsed() {
      return (resource.data.status == "active"
          || (resource.data.status == "reserved" && resource.data.reservedByUid == request.auth.uid))
        && request.resource.data.status == "used"
        && request.resource.data.reservedByUid == null
        && request.resource.data.usedByUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "reservedByUid", "usedByUid", "usedAt", "updatedAt"]);
    }

    function memberCanUndoMarkUsed() {
      return resource.data.status == "used"
        && resource.data.usedByUid == request.auth.uid
        && resource.data.usedAt is timestamp
        && request.time <= resource.data.usedAt + duration.value(5, "m")
        && request.resource.data.status == "active"
        && request.resource.data.reservedByUid == null
        && request.resource.data.usedByUid == null
        && request.resource.data.usedAt == null
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "reservedByUid", "usedByUid", "usedAt", "updatedAt"]);
    }

    function validGlobalNotificationSettings(data) {
      return data.get("defaultNotificationMode", "basic") in ["minimal", "basic", "careful"]
        && data.get("defaultNotificationDays", [7, 3, 1, 0]) is list
        && data.get("defaultNotificationDays", [7, 3, 1, 0]).hasOnly([7, 5, 3, 2, 1, 0])
        && data.get("pushEnabled", true) is bool;
    }

    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly([
          "displayName", "email", "photoUrl", "defaultNotificationMode",
          "defaultNotificationDays", "pushEnabled", "createdAt", "updatedAt"
        ])
        && validGlobalNotificationSettings(request.resource.data);
      allow delete: if false;

      match /pushTokens/{tokenId} {
        allow read, delete: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && tokenId.matches('^[a-f0-9]{64}$')
          && request.resource.data.keys().hasOnly([
            "token", "platform", "deviceName", "appVersion", "createdAt", "lastSeenAt"
          ])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 20
          && request.resource.data.token.size() <= 4096
          && request.resource.data.platform == "android"
          && request.resource.data.deviceName is string
          && request.resource.data.deviceName.size() <= 200
          && request.resource.data.appVersion is string
          && request.resource.data.appVersion.size() <= 30;
      }

      // 즐겨찾기는 사용자별 값이다. 쿠폰 문서에 favoritedBy 배열을 두면 남의
      // 즐겨찾기 때문에 쿠폰 문서가 갱신되고, 그 쓰기를 허용하려면 쿠폰 규칙을
      // 넓혀야 한다. 사용자 하위 컬렉션에 두면 쿠폰 규칙을 건드리지 않는다.
      //
      // 여기에는 참조(roomId/couponId)만 담는다. 제목·브랜드를 복사해 두면
      // 쿠폰을 수정했을 때 즐겨찾기 목록만 옛 정보를 보이게 된다.
      match /favorites/{favoriteId} {
        allow read, delete: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && favoriteId == request.resource.data.roomId + "__" + request.resource.data.couponId
          && request.resource.data.keys().hasOnly(["roomId", "couponId", "createdAt"])
          && request.resource.data.roomId is string
          && request.resource.data.roomId.size() > 0
          && request.resource.data.roomId.size() <= 128
          && request.resource.data.couponId is string
          && request.resource.data.couponId.size() > 0
          && request.resource.data.couponId.size() <= 128
          // 즐겨찾기는 접근 권한이 아니다. 방 멤버가 아닌 쿠폰을 담아 둘 수는
          // 있어도 그 쿠폰을 읽는 것은 여전히 쿠폰 규칙이 판정한다. 그래도
          // 무의미한 문서가 쌓이지 않게 멤버십을 요구한다.
          && isRoomMember(request.resource.data.roomId);
      }

      match /roomMemberships/{roomId} {
        allow read: if isSelf(uid);
        allow create, update, delete: if false;
      }
    }

    match /rooms/{roomId} {
      allow read: if isRoomMember(roomId);
      allow create, delete: if false;
      allow update: if isRoomOwner(roomId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["defaultNotificationMode", "defaultNotificationDays", "updatedAt"]);

      match /members/{uid} {
        allow read: if isRoomMember(roomId);
        allow create, delete: if false;
        allow update: if isSelf(uid)
          && isRoomMember(roomId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["notificationEnabled", "notificationMode", "notificationDays", "updatedAt"]);
      }

      match /coupons/{couponId} {
        allow read: if isRoomMember(roomId) && visibleCoupon(resource.data);
        allow create: if isRoomMember(roomId)
          && validCouponSchema(roomId, couponId)
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.status == "active"
          && request.resource.data.timezone == "Asia/Seoul"
          && visibleCoupon(request.resource.data);
        allow update: if isRoomMember(roomId)
          && visibleCoupon(resource.data)
          && (ownerCanEditCoupon(roomId, couponId) || memberCanReserve() || memberCanCancelReservation() || memberCanMarkUsed() || memberCanUndoMarkUsed());
        allow delete: if false;

        match /comments/{commentId} {
          allow read: if isRoomMember(roomId) && visibleParentCoupon(roomId, couponId);
          allow create: if isRoomMember(roomId)
            && visibleParentCoupon(roomId, couponId)
            && request.resource.data.keys().hasOnly([
              "authorUid", "authorName", "authorPhotoUrl", "body", "createdAt", "updatedAt"
            ])
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.authorName is string
            && (request.resource.data.authorPhotoUrl == null || request.resource.data.authorPhotoUrl is string)
            && request.resource.data.body is string
            && request.resource.data.body.size() > 0
            && request.resource.data.body.size() <= 500
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time;
          allow update: if false;
          allow delete: if isRoomMember(roomId)
            && visibleParentCoupon(roomId, couponId)
            && (resource.data.authorUid == request.auth.uid || isRoomOwner(roomId));
        }
      }
    }

    match /notificationLogs/{logId} {
      allow read, write: if false;
    }

    match /notificationOutbox/{messageId} {
      allow read, write: if false;
    }

    match /blobCleanupQueue/{cleanupId} {
      allow read, write: if false;
    }

    match /cronLeases/{leaseId} {
      allow read, write: if false;
    }

    match /roomSecrets/{roomId} {
      allow read, write: if false;
    }

    match /rateLimits/{limitId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
