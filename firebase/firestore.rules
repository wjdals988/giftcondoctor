rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function memberPath(roomId, uid) {
      return /databases/$(database)/documents/rooms/$(roomId)/members/$(uid);
    }

    function roomPath(roomId) {
      return /databases/$(database)/documents/rooms/$(roomId);
    }

    function couponPath(roomId, couponId) {
      return /databases/$(database)/documents/rooms/$(roomId)/coupons/$(couponId);
    }

    function isRoomMember(roomId) {
      return signedIn() && exists(memberPath(roomId, request.auth.uid));
    }

    function isRoomOwner(roomId) {
      return signedIn()
        && exists(roomPath(roomId))
        && get(roomPath(roomId)).data.ownerUid == request.auth.uid;
    }

    function visibleCoupon(data) {
      return data.visibility == "room" || data.ownerUid == request.auth.uid;
    }

    function visibleParentCoupon(roomId, couponId) {
      return exists(couponPath(roomId, couponId))
        && visibleCoupon(get(couponPath(roomId, couponId)).data);
    }

    function validCouponImagePath(roomId, couponId) {
      return request.resource.data.imageBlobPath is string
        && request.resource.data.imageBlobPath.matches(
          '^rooms/' + roomId + '/coupons/' + couponId + '/[A-Za-z0-9._-]+$'
        );
    }

    function validCouponSchema(roomId, couponId) {
      return request.resource.data.keys().hasOnly([
          "title", "brand", "ownerUid", "imageBlobPath", "imageWidth", "imageHeight",
          "expiresLocalDate", "expiresAtUtc", "timezone", "status", "reservedByUid",
          "usedByUid", "usedAt", "visibility", "notifyTarget", "createdAt", "updatedAt"
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.brand is string
        && request.resource.data.brand.size() <= 100
        && request.resource.data.expiresLocalDate is string
        && request.resource.data.expiresLocalDate.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.visibility in ["room", "private"]
        && request.resource.data.notifyTarget in ["allMembers", "ownerOnly"]
        && validCouponImagePath(roomId, couponId);
    }

    function immutableCouponFields() {
      return request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.imageBlobPath == resource.data.imageBlobPath
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function ownerCanEditCoupon(roomId, couponId) {
      return resource.data.ownerUid == request.auth.uid
        && immutableCouponFields()
        && validCouponSchema(roomId, couponId)
        && visibleCoupon(request.resource.data);
    }

    function memberCanReserve() {
      return resource.data.status == "active"
        && request.resource.data.status == "reserved"
        && request.resource.data.reservedByUid == request.auth.uid
        && request.resource.data.usedByUid == resource.data.usedByUid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "reservedByUid", "updatedAt"]);
    }

    function memberCanCancelReservation() {
      return resource.data.status == "reserved"
        && request.resource.data.status == "active"
        && request.resource.data.reservedByUid == null
        && (resource.data.reservedByUid == request.auth.uid || resource.data.ownerUid == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "reservedByUid", "updatedAt"]);
    }

    function memberCanMarkUsed() {
      return (resource.data.status == "active"
          || (resource.data.status == "reserved" && resource.data.reservedByUid == request.auth.uid))
        && request.resource.data.status == "used"
        && request.resource.data.reservedByUid == null
        && request.resource.data.usedByUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "reservedByUid", "usedByUid", "usedAt", "updatedAt"]);
    }

    function validGlobalNotificationSettings(data) {
      return data.get("defaultNotificationMode", "basic") in ["minimal", "basic", "careful"]
        && data.get("defaultNotificationDays", [7, 3, 1, 0]) is list
        && data.get("defaultNotificationDays", [7, 3, 1, 0]).hasOnly([7, 5, 3, 2, 1, 0])
        && data.get("pushEnabled", true) is bool;
    }

    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly([
          "displayName", "email", "photoUrl", "defaultNotificationMode",
          "defaultNotificationDays", "pushEnabled", "createdAt", "updatedAt"
        ])
        && validGlobalNotificationSettings(request.resource.data);
      allow delete: if false;

      match /pushTokens/{tokenId} {
        allow read, delete: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && tokenId.matches('^[a-f0-9]{64}$')
          && request.resource.data.keys().hasOnly([
            "token", "platform", "deviceName", "appVersion", "createdAt", "lastSeenAt"
          ])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 20
          && request.resource.data.token.size() <= 4096
          && request.resource.data.platform == "android"
          && request.resource.data.deviceName is string
          && request.resource.data.deviceName.size() <= 200
          && request.resource.data.appVersion is string
          && request.resource.data.appVersion.size() <= 30;
      }

      match /roomMemberships/{roomId} {
        allow read: if isSelf(uid);
        allow create, update, delete: if false;
      }
    }

    match /rooms/{roomId} {
      allow read: if isRoomMember(roomId);
      allow create, delete: if false;
      allow update: if isRoomOwner(roomId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["defaultNotificationMode", "defaultNotificationDays", "updatedAt"]);

      match /members/{uid} {
        allow read: if isRoomMember(roomId);
        allow create, delete: if false;
        allow update: if isSelf(uid)
          && isRoomMember(roomId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["notificationEnabled", "notificationMode", "notificationDays", "updatedAt"]);
      }

      match /coupons/{couponId} {
        allow read: if isRoomMember(roomId) && visibleCoupon(resource.data);
        allow create: if isRoomMember(roomId)
          && validCouponSchema(roomId, couponId)
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.status == "active"
          && request.resource.data.timezone == "Asia/Seoul"
          && visibleCoupon(request.resource.data);
        allow update: if isRoomMember(roomId)
          && visibleCoupon(resource.data)
          && (ownerCanEditCoupon(roomId, couponId) || memberCanReserve() || memberCanCancelReservation() || memberCanMarkUsed());
        allow delete: if false;

        match /comments/{commentId} {
          allow read: if isRoomMember(roomId) && visibleParentCoupon(roomId, couponId);
          allow create: if isRoomMember(roomId)
            && visibleParentCoupon(roomId, couponId)
            && request.resource.data.keys().hasOnly([
              "authorUid", "authorName", "authorPhotoUrl", "body", "createdAt", "updatedAt"
            ])
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.authorName is string
            && (request.resource.data.authorPhotoUrl == null || request.resource.data.authorPhotoUrl is string)
            && request.resource.data.body is string
            && request.resource.data.body.size() > 0
            && request.resource.data.body.size() <= 500
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time;
          allow update: if false;
          allow delete: if isRoomMember(roomId)
            && visibleParentCoupon(roomId, couponId)
            && (resource.data.authorUid == request.auth.uid || isRoomOwner(roomId));
        }
      }
    }

    match /notificationLogs/{logId} {
      allow read, write: if false;
    }

    match /roomSecrets/{roomId} {
      allow read, write: if false;
    }

    match /rateLimits/{limitId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
