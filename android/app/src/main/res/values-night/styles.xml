<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      라이트 테마는 windowLightStatusBar=true 로 상태바 아이콘을 어둡게 그린다.
      다크에서 그 값을 그대로 두면 어두운 배경 위에 어두운 아이콘이 겹쳐 보이지 않는다.
      windowBackground 도 함께 어둡게 지정해 Compose 가 첫 프레임을 그리기 전
      흰 화면이 번쩍이는 현상을 막는다. 값은 GDDarkBackground(#101314)와 같다.
    -->
    <style name="Theme.Giftcondoctor" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/gd_dark_background</item>
    </style>
</resources>
